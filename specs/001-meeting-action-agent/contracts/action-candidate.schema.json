{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-action-agent.example/contracts/action-candidate.schema.json",
  "title": "Action candidate (Agent 출력)",
  "description": "Meeting Analyst / Action Manager가 내는 Action 후보. action_id, approved_by_human, history, field_source는 코드가 채우므로 Agent가 넣을 수 없다. status에 '완료'가 올 수 없다 (SPEC 9장 'Agent 출력의 status에 완료가 들어오면 거부'). Reviewer 통과 후 저장 계층이 action.schema.json 형태로 변환한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meeting_id",
    "assigner",
    "assignee",
    "task",
    "due_date",
    "due_date_normalized",
    "evidence",
    "timestamp",
    "status",
    "flags"
  ],
  "properties": {
    "meeting_id": { "$ref": "common.schema.json#/$defs/MeetingId" },
    "assigner": { "type": "string", "minLength": 1 },
    "assignee": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "due_date": { "type": "string", "minLength": 1 },
    "due_date_normalized": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/Date" }, { "type": "null" }]
    },
    "evidence": { "type": "string", "minLength": 1 },
    "extra_evidence": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/EvidenceQuote" }
    },
    "timestamp": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "status": {
      "description": "신규 추출 단계에서는 '신규' 또는 '확인 필요'만 의미가 있으나, 이행점검에서 재사용될 수 있어 Agent 설정 가능 상태 전체를 허용한다. '완료'는 불가.",
      "$ref": "common.schema.json#/$defs/AgentSettableStatus"
    },
    "flags": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Flag" },
      "uniqueItems": true
    },
    "flag_notes": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/Flag" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note"],
        "properties": {
          "note": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/EvidenceQuote" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$comment": "기한이 미정·확인 필요면 환산 날짜는 null (SPEC 5.4).",
      "if": {
        "properties": { "due_date": { "enum": ["미정", "확인 필요"] } },
        "required": ["due_date"]
      },
      "then": { "properties": { "due_date_normalized": { "type": "null" } } }
    },
    {
      "$comment": "조건부·지시여부애매 Action은 status가 '확인 필요' (SPEC 5.5).",
      "if": {
        "properties": { "flags": { "contains": { "enum": ["조건부", "지시여부애매"] } } },
        "required": ["flags"]
      },
      "then": { "properties": { "status": { "const": "확인 필요" } } }
    },
    {
      "$comment": "조건부는 조건을 flag_notes에 기재해야 한다 (SPEC 5.5).",
      "if": {
        "properties": { "flags": { "contains": { "const": "조건부" } } },
        "required": ["flags"]
      },
      "then": { "required": ["flag_notes"], "properties": { "flag_notes": { "required": ["조건부"] } } }
    }
  ]
}
