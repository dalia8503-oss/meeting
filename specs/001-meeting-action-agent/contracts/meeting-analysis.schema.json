{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-action-agent.example/contracts/meeting-analysis.schema.json",
  "title": "Meeting analysis (회의 분석 결과)",
  "description": "Meeting Analyst 출력. 저장 위치: meetings/<meeting_id>.analysis.json. SPEC 6.1, 7장(/analyze-meeting), US-06 기준. SPEC은 항목별 '근거 타임스탬프'만 요구하며 이 구조는 제안이다 (data-model.md 8장).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meeting_id",
    "key_discussions",
    "decisions",
    "open_issues",
    "needs_confirmation",
    "action_candidates"
  ],
  "properties": {
    "meeting_id": { "$ref": "common.schema.json#/$defs/MeetingId" },
    "key_discussions": { "type": "array", "items": { "$ref": "#/$defs/SummaryItem" } },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/SummaryItem" } },
    "open_issues": {
      "description": "미결사항. 제안·의견·질문 발언은 Action이 아니라 여기에 기록 (SPEC 5.5).",
      "type": "array",
      "items": { "$ref": "#/$defs/SummaryItem" }
    },
    "needs_confirmation": {
      "description": "확인 필요 사항 (/analyze-meeting 출력 항목, SPEC 7장).",
      "type": "array",
      "items": { "$ref": "#/$defs/SummaryItem" }
    },
    "action_candidates": {
      "description": "지시 0건인 회의는 빈 배열 (오류 아님, SPEC US-02).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instruction_type", "candidate"],
        "properties": {
          "instruction_type": {
            "description": "SPEC 5.5 중 Action을 생성하는 유형. 철회는 신규 Action이 아니라 이행점검에서 기존 Action에 적용하므로 제외했다.",
            "enum": ["지시·요청", "자발적 약속", "조건부", "지시여부애매"]
          },
          "candidate": { "$ref": "action-candidate.schema.json" }
        }
      }
    }
  },
  "$defs": {
    "SummaryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_timestamps"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidence_timestamps": {
          "description": "근거 발언의 timestamp. 최소 1개. 녹취에 없는 결정·논의는 US-06 실패 조건.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/Timestamp" }
        }
      }
    }
  }
}
