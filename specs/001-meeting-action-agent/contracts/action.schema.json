{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meeting-action-agent.example/contracts/action.schema.json",
  "title": "Action (저장된 지시사항)",
  "description": "저장 계층이 받는 Action. 기준: SPEC.md 5.2~5.6, 9장. Agent 출력은 이 스키마가 아니라 action-candidate.schema.json으로 검증한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "meeting_id",
    "assigner",
    "assignee",
    "task",
    "due_date",
    "due_date_normalized",
    "evidence",
    "extra_evidence",
    "timestamp",
    "status",
    "flags",
    "field_source",
    "approved_by_human",
    "history"
  ],
  "properties": {
    "action_id": {
      "description": "저장소 전체에서 유일한 순번 (예: A-001). 코드가 발급한다.",
      "type": "string",
      "pattern": "^A-[0-9]{3,}$"
    },
    "meeting_id": { "$ref": "common.schema.json#/$defs/MeetingId" },
    "assigner": {
      "description": "지시자. 불명확 시 '확인 필요'.",
      "type": "string",
      "minLength": 1
    },
    "assignee": {
      "description": "담당자. 불명확 시 '확인 필요'. 호칭(씨, 님)은 제거 (SPEC 5.4).",
      "type": "string",
      "minLength": 1
    },
    "task": { "type": "string", "minLength": 1 },
    "due_date": {
      "description": "기한 원문. 명시적 미정이면 '미정', 언급 없음·해석 불가면 '확인 필요' (SPEC 5.4).",
      "type": "string",
      "minLength": 1
    },
    "due_date_normalized": {
      "description": "회의일 기준 환산 날짜. 환산 근거가 없으면 null. 근거 없이 만들면 실패 (SPEC US-03).",
      "oneOf": [{ "$ref": "common.schema.json#/$defs/Date" }, { "type": "null" }]
    },
    "evidence": {
      "description": "근거 발언 원문. Reviewer가 해당 timestamp 발언 text의 부분 문자열인지 검증한다.",
      "type": "string",
      "minLength": 1
    },
    "extra_evidence": {
      "description": "추가 근거 발언 (같은 회의 중복 언급, 여러 발언에 걸친 지시). SPEC은 '목록'만 정의하며 항목 구조는 제안이다.",
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/EvidenceQuote" }
    },
    "timestamp": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "status": { "$ref": "common.schema.json#/$defs/Status" },
    "flags": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Flag" },
      "uniqueItems": true
    },
    "flag_notes": {
      "description": "플래그 부가 정보 (조건부의 조건, 기한변경제안의 새 기한 등). SPEC은 부가 정보 기재를 요구하지만 위치를 정하지 않아 둔 제안 필드이다.",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/Flag" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note"],
        "properties": {
          "note": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/EvidenceQuote" }
          }
        }
      }
    },
    "field_source": {
      "description": "필드명 → 출처. 키가 없으면 '녹취'. 사람 보강 값만 기록해도 된다.",
      "type": "object",
      "propertyNames": {
        "enum": ["assigner", "assignee", "task", "due_date", "due_date_normalized"]
      },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/FieldSource" }
    },
    "approved_by_human": {
      "description": "현재(최신) 승인 정보. '완료'의 필수 조건이다. 승인 전에는 null이고, 완료 철회 후에도 지우지 않고 보존한다 (SPEC 5.2, 5.6). 재완료는 새 승인이 필요하며(코드 가드가 검증), 과거 승인은 history[].approval 스냅샷에 남는다.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Approval" }]
    },
    "history": {
      "description": "상태 변경과 재판정의 이력. 모든 항목을 시간순으로 남기며 삭제·덮어쓰기하지 않는다 (SPEC 5.6, 9장).",
      "type": "array",
      "items": { "$ref": "#/$defs/HistoryEntry" }
    }
  },
  "allOf": [
    {
      "$comment": "승인값 없이 '완료'가 저장되면 안 된다 (SPEC US-05, 9장). 코드 가드의 스키마 측 보강.",
      "if": { "properties": { "status": { "const": "완료" } }, "required": ["status"] },
      "then": { "properties": { "approved_by_human": { "type": "object" } } }
    },
    {
      "$comment": "기한이 미정·확인 필요면 환산 날짜는 null (SPEC 5.4).",
      "if": {
        "properties": { "due_date": { "enum": ["미정", "확인 필요"] } },
        "required": ["due_date"]
      },
      "then": { "properties": { "due_date_normalized": { "type": "null" } } }
    }
  ],
  "$defs": {
    "Approval": {
      "description": "승인 정보. approved_by_human(현재 값)과 history[].approval(과거 스냅샷)이 같은 구조를 쓴다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["approver", "approved_at", "evidence"],
      "properties": {
        "approver": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "evidence": {
          "description": "승인 근거 (meeting_id, timestamp)",
          "type": "object",
          "additionalProperties": false,
          "required": ["meeting_id", "timestamp"],
          "properties": {
            "meeting_id": { "$ref": "common.schema.json#/$defs/MeetingId" },
            "timestamp": { "$ref": "common.schema.json#/$defs/Timestamp" }
          }
        }
      }
    },
    "HistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "actor", "from_status", "to_status"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "actor": { "$ref": "common.schema.json#/$defs/Actor" },
        "kind": {
          "description": "항목 종류. 생략하면 '상태변경'. '재판정'은 상태가 유지되는 이행점검 결과 기록이며 from_status와 to_status가 같다 (같은지는 코드가 검증, SPEC 5.6).",
          "enum": ["상태변경", "재판정"]
        },
        "actor_name": {
          "description": "사람이 한 변경의 수행자 이름 (공백뿐인 값 불가). 완료 철회에서는 필수 (SPEC 5.6).",
          "type": "string",
          "pattern": "\\S"
        },
        "approval": {
          "description": "승인 정보 스냅샷. '완료' 전이에서는 그 시점의 새 승인, 완료 철회에서는 철회되는 승인. approved_by_human이 갱신돼도 과거 승인이 사라지지 않게 한다.",
          "$ref": "#/$defs/Approval"
        },
        "from_status": {
          "description": "최초 생성이면 null",
          "oneOf": [{ "$ref": "common.schema.json#/$defs/Status" }, { "type": "null" }]
        },
        "to_status": { "$ref": "common.schema.json#/$defs/Status" },
        "evidence": {
          "description": "상태 변경·재판정 근거. 이행점검이면 신규 회의의 발언.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/EvidenceQuote" }
        },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "$comment": "Agent는 '완료'로 전이시킬 수 없고, 승인 스냅샷이 있어야 한다 (SPEC 5.3, 5.6, US-05).",
          "if": { "properties": { "to_status": { "const": "완료" } }, "required": ["to_status"] },
          "then": { "properties": { "actor": { "const": "사람" } }, "required": ["approval"] }
        },
        {
          "$comment": "최초 생성 주체는 Agent뿐이다 (SPEC 3.2, 5.2). 사람의 수정·보강은 최초 생성 항목을 바꾸지 않는다.",
          "if": { "properties": { "from_status": { "type": "null" } }, "required": ["from_status"] },
          "then": { "properties": { "actor": { "const": "Agent" } } }
        },
        {
          "$comment": "완료 철회는 사람만 하며 철회자 이름과 철회되는 승인 스냅샷을 남긴다 (SPEC 5.6).",
          "if": { "properties": { "from_status": { "const": "완료" } }, "required": ["from_status"] },
          "then": { "properties": { "actor": { "const": "사람" } }, "required": ["actor_name", "approval"] }
        },
        {
          "$comment": "재판정 기록: Agent가 남기며 근거와 사유가 필수 (SPEC 5.6).",
          "if": { "properties": { "kind": { "const": "재판정" } }, "required": ["kind"] },
          "then": {
            "properties": {
              "actor": { "const": "Agent" },
              "evidence": { "minItems": 1 },
              "note": { "minLength": 1 }
            },
            "required": ["evidence", "note"]
          }
        }
      ]
    }
  }
}
